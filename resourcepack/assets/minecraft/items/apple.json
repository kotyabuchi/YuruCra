{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      { "when": "pumpking:honey_apple", "model": { "type": "minecraft:model", "model": "pumpking:item/food/honey_apple" } },
      { "when": "pumpking:chocolate", "model": { "type": "minecraft:model", "model": "pumpking:item/food/chocolate" } }
    ],
    "fallback": { "type": "minecraft:model", "model": "minecraft:item/apple" }
  }
}
