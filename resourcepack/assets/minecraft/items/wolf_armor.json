{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "pumpking:copper_wolf_armor",
        "model": {
          "type": "minecraft:model",
          "model": "pumpking:item/armor/copper_wolf_armor"
        }
      },
      {
        "when": "pumpking:iron_wolf_armor",
        "model": {
          "type": "minecraft:model",
          "model": "pumpking:item/armor/iron_wolf_armor"
        }
      },
      {
        "when": "pumpking:golden_wolf_armor",
        "model": {
          "type": "minecraft:model",
          "model": "pumpking:item/armor/golden_wolf_armor"
        }
      },
      {
        "when": "pumpking:diamond_wolf_armor",
        "model": {
          "type": "minecraft:model",
          "model": "pumpking:item/armor/diamond_wolf_armor"
        }
      },
      {
        "when": "pumpking:netherite_wolf_armor",
        "model": {
          "type": "minecraft:model",
          "model": "pumpking:item/armor/netherite_wolf_armor"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "component": "minecraft:dyed_color",
      "property": "minecraft:has_component",
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/wolf_armor"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/wolf_armor_dyed",
        "tints": [
          {
            "type": "minecraft:constant",
            "value": -1
          },
          {
            "type": "minecraft:dye",
            "default": 0
          }
        ]
      }
    }
  }
}
